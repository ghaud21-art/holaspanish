# 이 파일을 .env.local로 복사한 뒤 값을 채워주세요. (.env.local은 git에 커밋되지 않아요)
#
# 아래 두 값이 채워져야 "Supabase 연동 모드"로 동작합니다.
# 비어있으면 자동으로 로컬 파일(.local-db.json) 모드로 동작해요 (내 컴퓨터에서만 테스트할 때 편함).
# 설정 방법은 README.md의 "Supabase 설정" 부분을 참고하세요.

SUPABASE_URL=
# Supabase 대시보드 > Project Settings > API 의 "service_role" 키예요 (anon 키 아님 — 서버에서만 쓰고
# 절대 브라우저로 보내지지 않으니 안전해요).
SUPABASE_SERVICE_ROLE_KEY=

# --- 구글 로그인(회원가입/로그인)용 값 ---
# 위 Supabase 값과는 별개의 "OAuth 클라이언트 ID"예요. README.md의
# "구글 로그인(OAuth) 설정" 부분을 참고해서 발급받으세요.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# next-auth가 로그인 세션을 암호화하는 데 쓰는 임의의 비밀 문자열이에요.
# 아래 값을 그대로 써도 되고, 새로 만들고 싶으면 터미널에서
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 를 실행해서 나온 값으로 바꿔도 됩니다.
NEXTAUTH_SECRET=zh5o3d72EPMwZvg21d3/KlYq+b6QIpyfnUtARd4pvGs=

# 배포된 주소. 로컬 개발 중에는 아래 값 그대로 두면 됩니다.
NEXTAUTH_URL=http://localhost:3000

# 관리자 권한을 줄 구글 이메일 주소들. 쉼표로 여러 개 등록 가능해요.
# 예: ADMIN_EMAILS=me@gmail.com,friend@gmail.com
ADMIN_EMAILS=

# --- Gemini API (작문 첨삭 + 단어장 생성) ---
# https://aistudio.google.com/apikey 에서 발급받으세요. 비어있으면 작문 첨삭은 규칙 기반
# 모의 채점으로 자동 대체되고, 단어장 생성 기능은 비활성화돼요.
GEMINI_API_KEY=
